{
  "name": "think-logger3",
  "version": "1.4.0",
  "description": "logger for ThinkJS 3.x",
  "main": "./src",
  "types": "index.d.ts",
  "scripts": {
    "test": "pnpm run eslint && pnpm run test-cov",
    "test-cov": "nyc ava test/ && nyc report --reporter=html",
    "eslint": "eslint ./src",
    "prepublish": "pnpm test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/thinkjs/thinkjs",
    "directory": "packages/think-logger3"
  },
  "keywords": [
    "thinkjs",
    "logger",
    "log4js"
  ],
  "author": "lizheming",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/thinkjs/think-logger/issues"
  },
  "homepage": "https://github.com/thinkjs/think-logger#readme",
  "dependencies": {
    "log4js": "^6.4.0"
  },
  "devDependencies": {
    "ava": "^8.0.1",
    "eslint": "^10.8.0",
    "nyc": "^18.0.0",
    "sandboxed-module": "^2.0.3"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "ava": {
    "failWithoutAssertions": false,
    "serial": true,
    "timeout": "60s"
  }
}
