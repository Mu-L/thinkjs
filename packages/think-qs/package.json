{
  "name": "think-qs",
  "description": "Use qs module to parse query & post data, support array & object value",
  "version": "1.0.1",
  "author": {
    "name": "welefen",
    "email": "welefen@gmail.com"
  },
  "pre-commit": [
    "test"
  ],
  "scripts": {
    "test": "pnpm run lint && pnpm run test-cov",
    "test-cov": "nyc ava test/ && nyc report --reporter=html",
    "lint": "eslint index.js",
    "prepublish": "pnpm test"
  },
  "contributors": [
    {
      "name": "welefen",
      "email": "welefen@gmail.com"
    }
  ],
  "main": "index.js",
  "dependencies": {
    "qs": "^6.5.1"
  },
  "devDependencies": {
    "ava": "^8.0.1",
    "eslint": "^10.8.0",
    "nyc": "^18.0.0",
    "pre-commit": "^1.2.2"
  },
  "keywords": [
    "qs"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/thinkjs/thinkjs",
    "directory": "packages/think-qs"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "license": "MIT",
  "readmeFilename": "README.md",
  "bugs": {
    "url": "https://github.com/thinkjs/think-qs/issues"
  },
  "ava": {
    "failWithoutAssertions": false,
    "serial": true,
    "timeout": "60s"
  }
}
