{
  "name": "think-helmet",
  "description": "Important security headers for ThinkJS 3.x",
  "version": "1.0.2",
  "author": {
    "name": "welefen",
    "email": "welefen@gmail.com"
  },
  "scripts": {
    "test": "pnpm run lint && pnpm run test-cov",
    "test-cov": "nyc ava test/ && nyc report --reporter=html",
    "lint": "eslint index.js"
  },
  "contributors": [
    {
      "name": "welefen",
      "email": "welefen@gmail.com"
    }
  ],
  "dependencies": {
    "koa-helmet": "^4.1.0"
  },
  "devDependencies": {
    "ava": "^8.0.1",
    "eslint": "^10.8.0",
    "nyc": "^18.0.0"
  },
  "keywords": [
    "helmet"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/thinkjs/thinkjs",
    "directory": "packages/think-helmet"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "license": "MIT",
  "readmeFilename": "README.md",
  "bugs": {
    "url": "https://github.com/thinkjs/think-helmet/issues"
  },
  "ava": {
    "failWithoutAssertions": false,
    "serial": true,
    "timeout": "60s"
  }
}
