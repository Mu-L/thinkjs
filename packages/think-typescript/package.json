{
  "name": "think-typescript",
  "version": "2.0.0",
  "description": "Use TypeScript transpile ts to js",
  "main": "index.js",
  "scripts": {
    "lint": "eslint index.js",
    "test": "pnpm run lint && nyc ava test/",
    "coverage": "pnpm test && nyc report --reporter=html"
  },
  "ava": {
    "files": [
      "test/*.js"
    ],
    "failWithoutAssertions": false,
    "serial": true,
    "timeout": "60s"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/thinkjs/thinkjs",
    "directory": "packages/think-typescript"
  },
  "keywords": [
    "think-typescript"
  ],
  "author": {
    "name": "lushijie",
    "email": "lushijie1218@126.com"
  },
  "contributors": [
    {
      "name": "lushijie",
      "email": "lushijie1218@126.com"
    }
  ],
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/thinkjs/think-typescript/issues"
  },
  "homepage": "https://github.com/thinkjs/think-typescript#readme",
  "devDependencies": {
    "ava": "^8.0.1",
    "coveralls": "~2.11.16",
    "eslint": "^10.8.0",
    "nyc": "^18.0.0"
  },
  "dependencies": {
    "line-column": "~1.0.2",
    "think-helper": "~1.0.0",
    "typescript": "^3.5.3"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
