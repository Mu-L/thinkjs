{
  "name": "think-validator",
  "version": "1.7.0",
  "description": "Validator for ThinkJS",
  "main": "src/index.js",
  "scripts": {
    "lint": "eslint src/",
    "test": "pnpm run lint && nyc ava test/index.js",
    "coverage": "pnpm test && nyc report --reporter=html"
  },
