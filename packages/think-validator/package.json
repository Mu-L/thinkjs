  "bugs": {
    "url": "https://github.com/thinkjs/think-validator/issues"
  },
  "homepage": "https://github.com/thinkjs/think-validator#readme",
  "devDependencies": {
    "ava": "^8.0.1",
    "coveralls": "~2.11.16",
    "eslint": "^10.8.0",
    "nyc": "^18.0.0"
  },
  "dependencies": {
    "think-helper": "^1.1.3",
