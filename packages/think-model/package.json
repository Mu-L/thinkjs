{
  "name": "think-model",
  "version": "1.5.4",
  "description": "An adapter-based ORM for ThinkJS 3.x",
  "scripts": {
    "watch": "babel ./src --out-dir ./lib --watch",
    "compile": "babel ./src --out-dir ./lib",
    "test": "pnpm run compile && pnpm run eslint && pnpm run test-cov",
    "test-cov": "nyc ava test/ && nyc report --reporter=html",
    "eslint": "eslint ./src",
    "prepublish": "pnpm test && pnpm run compile",
    "semantic-release": "semantic-release"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/thinkjs/thinkjs",
    "directory": "packages/think-model"
  },
  "keywords": [
    "thinkjs",
    "orm",
    "mysql",
    "adapter",
    "model"
  ],
  "types": "index.d.ts",
  "author": "lizheming",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/thinkjs/think-model/issues"
  },
  "homepage": "https://github.com/thinkjs/think-model#readme",
  "dependencies": {
    "think-cache": "^1.0.7",
    "think-debounce": "^1.0.3",
    "think-helper": "^1.0.22",
    "think-model-abstract": "^1.2.0"
  },
  "devDependencies": {
    "@semantic-release/github": "^5.4.3",
    "@semantic-release/npm": "^5.1.15",
    "ava": "^8.0.1",
    "babel-cli": "^6.26.0",
    "babel-core": "^6.26.0",
    "babel-preset-think-node": "^1.0.1",
    "eslint": "^10.8.0",
    "muk": "^0.5.3",
    "nyc": "^18.0.0",
    "semantic-release": "^15.13.24"
  },
  "babel": {
    "presets": [
      "think-node"
    ]
  },
  "release": {
    "branche": "master",
    "plugins": [
      "@semantic-release/npm",
      "@semantic-release/github"
    ]
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "ava": {
    "failWithoutAssertions": false,
    "serial": true,
    "timeout": "60s"
  }
}
