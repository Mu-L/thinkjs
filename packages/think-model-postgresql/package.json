{
  "name": "think-model-postgresql",
  "version": "1.1.10",
  "description": "PostgreSQL adapter for ThinkJS 3.x",
  "scripts": {
    "test": "pnpm run eslint && pnpm run test-cov",
    "test-cov": "nyc ava test/ && nyc report --reporter=html",
    "eslint": "eslint ./lib",
    "prepublish": "pnpm test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/thinkjs/thinkjs",
    "directory": "packages/think-model-postgresql"
  },
  "keywords": [
    "thinkjs",
    "orm",
    "mysql",
    "adapter",
    "model"
  ],
  "author": "lizheming",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/thinkjs/think-model-postgresql/issues"
  },
  "homepage": "https://github.com/thinkjs/think-model-postgresql#readme",
  "dependencies": {
    "pg": "^8.5.1",
    "think-debounce": "^1.0.3",
    "think-helper": "^1.0.5",
    "think-instance": "^1.0.1",
    "think-model-abstract": "^1.0.0"
  },
  "devDependencies": {
    "ava": "^8.0.1",
    "eslint": "^10.8.0",
    "mock-require": "^3.0.2",
    "muk": "^0.5.3",
    "nyc": "^18.0.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "ava": {
    "failWithoutAssertions": false,
    "serial": true,
    "timeout": "60s"
  }
}
