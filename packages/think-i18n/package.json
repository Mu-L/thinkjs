{
  "name": "think-i18n",
  "version": "1.3.2",
  "description": "i18n solution in thinkjs 3.0",
  "main": "index.js",
  "types": "index.d.ts",
  "scripts": {
    "test": "eslint index.js && eslint src/ && node --test --test-concurrency=1 test/i18n.js test/i18n_extend.js test/index.js",
    "lint": "eslint index.js src/",
    "lint-fix": "eslint --fix index.js src/",
    "coverage": "node --test --test-concurrency=1 --experimental-test-coverage test/i18n.js test/i18n_extend.js test/index.js"
  },
  "bundledDependencies": [
    "numeral",
    "moment"
  ],
  "dependencies": {
    "cookie": "^0.3.1",
    "jed": "^1.1.1",
    "moment": "^2.18.1",
    "numeral": "^2.0.6",
    "think-helper": "^1.1.3"
  },
  "devDependencies": {
    "babel-core": "^6.22.1",
    "coveralls": "~2.11.16",
    "eslint": "^10.8.0",
    "mock-require": "^2.0.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/thinkjs/thinkjs",
    "directory": "packages/think-i18n"
  },
  "keywords": [
    "thinkjs-extend",
    "thinkjs",
    "i18n",
    "l10n"
  ],
  "author": "Sijie Cai <sijie.cai@qq.com>",
