{
  "name": "think-mongo",
  "version": "2.2.1",
  "description": "Mongo adaper",
  "scripts": {
    "watch": "babel ./src --out-dir ./lib --watch",
    "compile": "babel ./src --out-dir ./lib",
    "test": "pnpm run lint && pnpm run test-cov",
    "test-cov": "nyc ava test/ && nyc report --reporter=html",
    "lint": "eslint ./src",
    "lint-fix": "eslint --fix ./src",
    "prepublish": "pnpm test && pnpm run compile",
    "coverage": "nyc report --reporter=html"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/thinkjs/thinkjs",
    "directory": "packages/think-mongo"
  },
  "keywords": [
    "thinkjs",
    "orm",
    "mysql",
    "adapter",
    "model"
  ],
  "author": "lizheming",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/thinkjs/think-mongo/issues"
  },
  "homepage": "https://github.com/thinkjs/think-mongo#readme",
  "dependencies": {
    "generic-pool": "^3.1.7",
    "mongodb": "^3.5.9",
    "think-helper": "^1.1.3",
    "think-instance": "^1.0.2"
  },
  "devDependencies": {
    "ava": "^8.0.1",
    "babel-cli": "^6.24.1",
    "babel-core": "^6.24.1",
    "babel-preset-think-node": "^1.0.2",
    "eslint": "^10.8.0",
    "muk": "^0.5.3",
    "nyc": "^18.0.0"
  },
  "babel": {
    "presets": [
      "think-node"
    ]
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "ava": {
    "failWithoutAssertions": false,
    "serial": true,
    "timeout": "60s"
  }
}
